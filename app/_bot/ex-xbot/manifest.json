{
    
    "manifest_version": 2,
    "name": "Ax Chatbot",
    "version": "3.5.3",
    "description": "Envio de mensajes a whatsapp",
    "browser_action": {
        "default_icon": "icon48_off.png",
        "default_popup": "settings_popup.html",
        "default_title": "Ax-ChatBot"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://web.whatsapp.com/*"
            ],
            "js": [
                "config.js",
                "script.js"
            ],
            "run_at": "document_end"
        }
    ],
    "options_page": "settings.html",
    "web_accessible_resources": [
        "client.js"
    ],
    "background": {
        "scripts": [
            "config.js",
            "background.js"
        ],
        "persistent": true
    },
    "permissions": [
        "tabs",
        "webRequest",
        "webRequestBlocking",
        "http://*/"
    ]
}