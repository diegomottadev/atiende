# ============================================================
#  ATIENDE / ATIENDE  -  Variables de entorno Docker
#  Copiar a .env y ajustar valores
# ============================================================

# IP del host para resolver dominios de test desde los containers
# Windows/Mac Docker Desktop: dejar "host-gateway"
# Linux: usar IP de la interfaz docker0 (normalmente 172.17.0.1)
HOST_IP=host-gateway

# Credenciales MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=atiende
MYSQL_USER=atiende
MYSQL_PASSWORD=root

# Puerto MySQL expuesto al host (3307 para no pisar un MySQL local)
DB_PORT=3307

# Puerto Nginx expuesto al host
APP_PORT=81
