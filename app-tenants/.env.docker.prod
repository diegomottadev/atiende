APP_URL=https://admin.atiende.lat
APP_ENV=production

# MariaDB
DB_HOST=COMPLETAR_db_host
DB_PORT=3306
DB_NAME=pedidos_platform
DB_USER=COMPLETAR_db_user
DB_PASS=COMPLETAR_db_pass
DB_PROVISIONER_USER=COMPLETAR_provisioner_user
DB_PROVISIONER_PASS=COMPLETAR_provisioner_pass
DB_AXBOT_NAME=axbot

# Encryption — DEBE coincidir con PLATFORM_ENCRYPTION_KEY de app/config/global.php (atiende)
PLATFORM_ENCRYPTION_KEY=COMPLETAR_64_HEX_CHARS

# SMTP
SMTP_HOST=COMPLETAR_smtp_host
SMTP_PORT=587
SMTP_USER=COMPLETAR_smtp_user
SMTP_PASS=COMPLETAR_smtp_pass
SMTP_FROM=noreply@pedidos.app
SMTP_FROM_NAME="Pedidos Platform"
SUPERADMIN_EMAIL=COMPLETAR_superadmin_email

# MercadoPago
MP_ACCESS_TOKEN=COMPLETAR_mp_access_token
MP_WEBHOOK_SECRET=COMPLETAR_mp_webhook_secret

# Stripe
STRIPE_SECRET_KEY=COMPLETAR_stripe_secret_key
STRIPE_WEBHOOK_SECRET=COMPLETAR_stripe_webhook_secret
